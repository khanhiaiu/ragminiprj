  "collection": "docs",
  "vector_name": "dense",
  "vector_size": 1024,
  "distance": "Cosine",
  "payload_indexes": ["doc_id", "type"],
  "embedder": "BAAI/bge-m3",
  "embedder_fallback": "hash",
  "embed_batch_size": 8,
  "ingest_backend_default": "local",
