# Copy nothing anywhere: real secrets stay in .env (gitignored).
# Local Qdrant (docker-compose):
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Direct Gemini Developer API used for image captioning.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Qdrant Cloud example (uncomment to use):
# QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io
# QDRANT_API_KEY=<cloud api key>
